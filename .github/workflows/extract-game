name: Extract Midnight Club 3 Remix Game Files

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  extract-game:
    runs-on: macos-latest
    timeout-minutes: 120

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract project
        run: |
          set -euo pipefail

          mkdir -p "$RUNNER_TEMP/mc3-source"

          unzip -q mcdub3-nx-ios-v1.1.0.zip \
            -d "$RUNNER_TEMP/mc3-source"

          echo "SOURCE_DIR=$RUNNER_TEMP/mc3-source/mcdub3-nx-ios-v1.1.0" >> "$GITHUB_ENV"

      - name: Install extraction dependencies
        run: |
          brew install python
          python3 -m pip install --user gdown

      - name: Download game ISO
        env:
          GDRIVE_FILE_ID: "1Eql0Jl38mS8PuYSkc0EWIsuKhLr2bZdU"
        run: |
          set -euo pipefail

          python3 -m gdown "$GDRIVE_FILE_ID" \
            -O "$RUNNER_TEMP/mc3-remix.iso"

          test -s "$RUNNER_TEMP/mc3-remix.iso"

      - name: Extract game files
        working-directory: ${{ env.SOURCE_DIR }}
        run: |
          set -euo pipefail

          make GAME=remix extract ISO="$RUNNER_TEMP/mc3-remix.iso"

          test -f game-remix/default.xbe

          echo "Extracted game files:"
          du -sh game-remix
          find game-remix -maxdepth 2 -type f | head -30

      - name: Package extracted game files
        working-directory: ${{ env.SOURCE_DIR }}
        run: |
          set -euo pipefail

          ditto -c -k --sequesterRsrc --keepParent \
            game-remix \
            "$GITHUB_WORKSPACE/Midnight-Club-3-Remix-Game-Files.zip"

          ls -lh "$GITHUB_WORKSPACE/Midnight-Club-3-Remix-Game-Files.zip"

      - name: Upload extracted game files
        uses: actions/upload-artifact@v4
        with:
          name: Midnight-Club-3-Remix-Game-Files
          path: Midnight-Club-3-Remix-Game-Files.zip
          if-no-files-found: error
          retention-days: 7
