name: Namco Museum - Extract Game Files

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  extract:
    name: Extract Namco Museum XISO
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y cmake build-essential zip

          python -m pip install --upgrade pip
          python -m pip install gdown

      - name: Build extract-xiso
        run: |
          set -euo pipefail

          git clone --depth 1 \
            https://github.com/XboxDev/extract-xiso.git \
            "$RUNNER_TEMP/extract-xiso"

          cmake \
            -S "$RUNNER_TEMP/extract-xiso" \
            -B "$RUNNER_TEMP/extract-xiso/build"

          cmake --build \
            "$RUNNER_TEMP/extract-xiso/build" \
            --parallel 2

          test -x "$RUNNER_TEMP/extract-xiso/build/extract-xiso"

      - name: Download Namco Museum XISO
        run: |
          set -euo pipefail

          mkdir -p "$RUNNER_TEMP/namco/input"

          gdown --fuzzy \
            "https://drive.google.com/file/d/1mHlZ2hqkAexh89G46LNB0dpdgH2MaO11/view?usp=drivesdk" \
            -O "$RUNNER_TEMP/namco/input/namco-museum.xiso.iso"

          test -s "$RUNNER_TEMP/namco/input/namco-museum.xiso.iso"

          ls -lh "$RUNNER_TEMP/namco/input/namco-museum.xiso.iso"

      - name: Extract Xbox game files
        run: |
          set -euo pipefail

          mkdir -p "$RUNNER_TEMP/namco/game"

          "$RUNNER_TEMP/extract-xiso/build/extract-xiso" \
            "$RUNNER_TEMP/namco/input/namco-museum.xiso.iso" \
            -d "$RUNNER_TEMP/namco/game"

          XBE_PATH="$(find "$RUNNER_TEMP/namco/game" \
            -type f -iname default.xbe -print -quit)"

          if [[ -z "$XBE_PATH" ]]; then
            echo "::error::default.xbe was not found in the extracted game."
            exit 1
          fi

          echo "Found executable: $XBE_PATH"

          FILE_COUNT=$(find "$RUNNER_TEMP/namco/game" -type f | wc -l)
          echo "Extracted file count: $FILE_COUNT"

          du -sh "$RUNNER_TEMP/namco/game"

          echo "XBE_PATH=$XBE_PATH" >> "$GITHUB_ENV"

      - name: Create downloadable game archive
        run: |
          set -euo pipefail

          OUTPUT="$GITHUB_WORKSPACE/NamcoMuseum-Extracted-Game-Files.zip"

          cd "$RUNNER_TEMP/namco"

          zip -qry "$OUTPUT" game

          unzip -tq "$OUTPUT"

          test -s "$OUTPUT"

          echo "Archive size:"
          ls -lh "$OUTPUT"

          echo "SHA256:"
          sha256sum "$OUTPUT" | tee "$GITHUB_WORKSPACE/NamcoMuseum-Extracted-Game-Files.sha256"

      - name: Upload extracted Namco Museum game
        uses: actions/upload-artifact@v4
        with:
          name: NamcoMuseum-Extracted-Game-Files
          path: |
            NamcoMuseum-Extracted-Game-Files.zip
            NamcoMuseum-Extracted-Game-Files.sha256
          if-no-files-found: error
          retention-days: 30
